# Postgres -> connection string ke server di VPS/lokal kamu
DATABASE_URL=postgres://user:password@host:5432/airdrop

# Password buat masuk dashboard (bebas)
APP_PASSWORD=gantiini

# Web Push -> generate: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=B...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:kamu@email.com

# Dipakai buat manggil /api/cron dari luar (cron job, curl, dst — isi bebas)
CRON_SECRET=rahasia123

# Dipakai endpoint POST /api/projects buat nerima data dari script eksternal (isi bebas, panjangin)
PROJECTS_API_KEY=gantiini-juga
